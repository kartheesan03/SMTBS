FROM node:20-alpine

# Install native build tools and system dependencies required for SQLite and OCR
RUN apk add --no-cache python3 py3-pip make g++ sqlite-dev libmagic file tesseract-ocr tesseract-ocr-data-eng

WORKDIR /app
COPY package*.json ./

# npm ci uses package-lock.json for reproducible installs; postinstall will rebuild sqlite3 from source
RUN npm ci --omit=dev

COPY . .

# Set up Python virtual environment and install OCR dependencies
RUN python3 -m venv /app/ocr_service/venv
ENV PATH="/app/ocr_service/venv/bin:$PATH"
RUN pip3 install --no-cache-dir -r /app/ocr_service/requirements.txt

EXPOSE 5000
CMD ["npm", "start"]
